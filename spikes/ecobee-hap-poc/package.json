{
  "name": "ecobee-hap-poc",
  "version": "0.1.8",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:apk": "node scripts/build-local-apk.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand --coverage=false",
    "audit:secrets": "node scripts/scan-evidence.mjs",
    "audit:dependencies": "npm audit --omit=dev"
  },
  "dependencies": {
    "@inthepocket/react-native-service-discovery": "0.2.12",
    "@react-native-community/netinfo": "12.0.1",
    "assert": "2.1.0",
    "buffer": "6.0.3",
    "expo": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "fast-srp-hap": "2.0.4",
    "libsodium-wrappers": "0.7.15",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-quick-crypto": "1.1.7",
    "react-native-tcp-socket": "6.4.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.8.5",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts",
      "<rootDir>/test/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@react-navigation/.*|libsodium-wrappers|fast-srp-hap))"
    ]
  }
}
