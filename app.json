{
  "expo": {
    "name": "Home Dashboard",
    "slug": "home-dashboard",
    "version": "2.1.16",
    "sdkVersion": "57.0.0",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#002b36"
        }
      ],
      "./plugins/withAndroidHardening"
    ],
    "android": {
      "package": "com.zhna123.homedashboard.v2",
      "versionCode": 20116,
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "ios": {
      "supportsTablet": true
    },
    "extra": {
      "eas": {
        "projectId": "992bb950-c035-11e9-857e-3f8f34599000"
      }
    }
  }
}
