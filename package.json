{
  "name": "home-dashboard",
  "version": "2.1.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-tcp-socket"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "start:android": "expo start --android",
    "start:lan": "expo start --lan",
    "start:localhost": "expo start --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand --coverage=false",
    "check:fixture-secrets": "node scripts/check-characterization-secrets.mjs",
    "doctor": "npx -y expo-doctor",
    "build": "npx eas-cli@latest build --platform android --profile release-apk",
    "build:apk": "node scripts/build-local-apk.mjs",
    "export:android": "expo export --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/material-top-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.26",
    "expo": "^57.0.0",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-tcp-socket": "^6.2.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "babel-preset-expo": "~57.0.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts",
      "<rootDir>/test/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@react-navigation/.*))"
    ]
  }
}
